<h3 style="margin-top: 30px; margin-bottom: 30px;">10問中<span style="color: #FF0000;"><%= @judge.count(true) %>問</span>正解 !</h3>
<%= link_to "クイズに戻る", nogikuis_index_path %>
<hr>
<div style="margin-top: 50px; position: relative;">
  <div class="number">
    <h4>1</h4>
  </div> 
  <div style="display: inline-block;">
    <% if @judge[0] == true %>
      <h3 style="color: #FF0000;">〇</h3>                                             
    <% else %>
      <h3 style="color: #0000FF;">×</h3>
    <% end %>
  </div>
  <div style="display: inline-block;">
    <h3><%= @your_answer[0] %></h3>
  </div>
  <div style="margin-top: 50px;">
    <h5>Q.<%= @random_q[0].question.content %></h5>
  </div>
  <div class="q_answer">
    <h4>A.<%= @answer[0].content %></h4>
  </div>
</div>
